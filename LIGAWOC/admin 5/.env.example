# NUNCA COMPARTIR ESTE ARCHIVO CON CREDENCIALES - ES TEMPLATE
# Copia como .env y reemplaza los valores

# ===== ENTORNO =====
APP_ENV=production
APP_DEBUG=false

# ===== BASE DE DATOS =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ligaojmj_WOC
DB_USER=ligaojmj_Woc
DB_PASS=TU_PASSWORD_AQUI

# ===== CORREO (SMTP) =====
SMTP_HOST=mail.ligawocdominicana.com
SMTP_USER=info@ligawocdominicana.com
SMTP_PASS=TU_PASSWORD_AQUI
SMTP_PORT=465

# ===== PAYPAL =====
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=TU_CLIENT_ID_AQUI
PAYPAL_CLIENT_SECRET=TU_CLIENT_SECRET_AQUI
PAYPAL_WEBHOOK_ID=TU_WEBHOOK_ID_AQUI

# ===== SEGURIDAD =====
SESSION_TIMEOUT=3600
SECURE_COOKIES=true
SAMESITE_COOKIES=Strict
